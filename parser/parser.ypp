%{
    #include <stdio.h>
%}

%union {
    int Int;
    int Bool
    double Double;
    char* String;
    char* Identifier
}

/* Литералы */
%token <Int> INT_LIT
%token <Double> DOUBLE_LIT
%token <Identifier> ID
%token <String> STRING_LIT
%token <Bool> BOOL_LIT

/* Ключевые слова */
%token BREAK_KW CATCH_KW CLASS_KW CONST_KW CONTINUE_KW
%token DEFAULT_KW DO_KW ELSE_KW ENUM_KW EXTENDS_KW FINAL_KW
%token FINALLY_KW FOR_KW IF_KW IN_KW IS_KW NEW_KW RETHROW_KW
%token RETURN_KW SUPER_KW THIS_KW THROW_KW TRY_KW
%token VAR_KW WHILE_KW TRUE_KW FALSE_KW NULL_KW
%token ABSTRACT_KW AS_KW EXPORT_KW FACTORY_KW GET_KW
%token IMPORT_KW REQUIRED_KW SET_KW STATIC_KW WHEN_KW LIST_KW

/* Типы */
%token VOID_TYPE

%token EQ NEQ LEQ GEQ /* == != <= >= */
%token LOG_AND LOG_OR /* && || */
%token INC DEC INTDIV/* ++ -- ~/ */

%token ADD_ASSIGN SUB_ASSIGN MUL_ASSIGN /* += -= *= */
%token DIV_ASSIGN MOD_ASSIGN INTDIV_ASSIGN /* /= %= ~/= */


/* приоритеты */
%right '=' ADD_ASSIGN SUB_ASSIGN MUL_ASSIGN DIV_ASSIGN MOD_ASSIGN INTDIV_ASSIGN /* assignment */
%right '?' ':' /* тернарный оператор */
%left LOG_OR /* logical OR */
%left LOG_AND /* logical AND */
%nonassoc EQ NEQ /* equality */
%nonassoc AS_KW IS_KW ISN_KW LEQ GEQ '<' '>' /* relational */
%left '+' '-' /* additive */
%left '*' '/' '%' INTDIV /* multiplicative */
%nonassoc '!' UMINUS /* префикс */
%nonassoc INC DEC '.' '[' /* постфикс */
%nonassoc '(' /* скобки */


%start program

%%


program:
      /* empty */
    | program top_level_decl
;


top_level_decl:
      var_decl ';'
    | func_decl
    | class_decl
;


stmt:
      var_decl ';'
    | expr ';'
    | ';'
    | for_stmt
    | while_stmt
    | do_while_stmt
    | if_stmt
    | return_stmt
    | stmt_block
    | BREAK_KW ';'
    | CONTINUE_KW ';'
;


stmt_block:
      '{' stmt_list_em '}'
;


stmt_list:
      stmt
    | stmt_list stmt
;


stmt_list_em:
      /* empty */
    | stmt_list
;


expr:
      primary
    | expr INC {$$ = createPostfixUnExpr(IncPostfixType, $1);} /* x++ */
    | expr DEC {$$ = createPostfixUnExpr(DecPostfixType, $1);} /* x-- */
    | expr '.' ID {$$ = createAccessFieldExpr($1, $3);} /* x.y */
    | THIS_KW '(' expr_list_empty ')' {$$ = createFuncCallExpr($1, $3);} /* x(...) */
    | SUPER_KW '(' expr_list_empty ')' {$$ = createFuncCallExpr($1, $3);} /* x(...) */
    | ID '(' expr_list_empty ')' {$$ = createFuncCallExpr($1, $3);} /* x(...) */
    | expr '.' ID '(' expr_list_empty ')' {$$ = createMethodCallExpr($1, $3, $5);} /* x.y(...) */
    | expr '[' expr ']' {$$ = createAccessArrElementExpr($1, $3);} /* x[i] */
    | INC expr %prec UMINUS {$$ = createPrifixUnExpr(IncPrefixType, $2);} /*++x*/
    | DEC expr %prec UMINUS {$$ = createPrifixUnExpr(DecPrefixType, $2);} /*--x*/ 
    | '-' expr %prec UMINUS {$$ = createPrifixUnExpr(UminusType, $2);} /*-x*/
    | '!' expr {$$ = createPrifixUnExpr(NotType, $2);} /*!x*/
    | expr '*' expr {$$ = createBinExpr(MulType, $1, $3);} /* x*y */ 
    | expr '/' expr {$$ = createBinExpr(DivType, $1, $3);} /* x/y */
    | expr '%' expr {$$ = createBinExpr(ModType, $1, $3);} /* x%y */
    | expr INTDIV expr {$$ = createBinExpr(IntDivType, $1, $3);} /* x~/y */
    | expr '+' expr {$$ = createBinExpr(AddType, $1, $3);} /* x+y */
    | expr '-' expr {$$ = createBinExpr(MinusType, $1, $3);} /* x-y */
    | expr '<' expr {$$ = createBinExpr(MinuLessTypesType, $1, $3);} /* x<y */
    | expr '>' expr {$$ = createBinExpr(GreaterType, $1, $3);} /* x>y */
    | expr LEQ expr {$$ = createBinExpr(LEqType, $1, $3);} /* x<=y */
    | expr GEQ expr {$$ = createBinExpr(GEqType, $1, $3);} /* x>=y */
    | expr IS_KW type {$$ = createOperationTypeExpr(IsType, $2, $3);} /* x is y */
    | expr AS_KW type {$$ = createOperationTypeExpr(AsType, $2, $3);} /* x as y */
    | expr IS_KW '!' type {$$ = createOperationTypeExpr(NIsType, $2, $4);} /* x is! */
    | expr EQ expr {$$ = createBinExpr(EqEqType, $1, $3);} /* x==y */
    | expr NEQ expr {$$ = createBinExpr(NEqType, $1, $3);} /* x!=y */
    | expr LOG_AND expr {$$ = createBinExpr(LogAndType, $1, $3);} /* x&&y */
    | expr LOG_OR expr {$$ = createBinExpr(LogOrType, $1, $3);} /* x||y */
    | expr '?' expr ':' expr {$$ = createTernaryOperatorExpr($1, $3, $5); }
    | expr ADD_ASSIGN expr {$$ = createBinExpr(AddAssignType, $1, $3);} /* x+=y */
    | expr SUB_ASSIGN expr {$$ = createBinExpr(SubAssignType, $1, $3);} /* x-=y */
    | expr MUL_ASSIGN expr {$$ = createBinExpr(MulAssignType, $1, $3);} /* x*=y */
    | expr DIV_ASSIGN expr {$$ = createBinExpr(DivAssignType, $1, $3);} /* x/=y */
    | expr MOD_ASSIGN expr {$$ = createBinExpr(ModAssignType, $1, $3);} /* x%=y */
    | expr INTDIV_ASSIGN expr {$$ = createBinExpr(IntDivAssignType, $1, $3);} /* x~/=y */
    | expr '=' expr {$$ = createBinExpr(EqType, $1, $3);} /* x=y */
;


primary: /*базовые литералы*/
      INT_LIT {$$ = createIntExpr($1);}
    | DOUBLE_LIT {$$ = createDoubleExpr($1)}
    | ID {$$ = createIDExpr($1)}
    | STRING_LIT {$$ = createStringExpr($1)}
    | BOOL_LIT {$$ = createBoolExpr($1)}
    | NULL_KW {$$ = createExpr(NullType)}
    | SUPER_KW {$$ = createExpr(SuperType)}
    | THIS_KW {$$ = createExpr(ThisType)}
    | '(' expr ')' {$$ = $2; $$->insideParens = 1;}
    | '[' expr_list_empty ']'
;


type:
      ID {$$ = createIdType($1);}
    | LIST_KW '<' type '>' {$$ = createArrayType($3);}
;


expr_list_empty:
      expr_list {$$ = $1;}
    | /*empty*/ {$$ = NULL;}
;


expr_list:
      expr {$$ = $1;}
    | expr_list ',' expr {$$ = addExprToListExpr($1, $3);}
;


/* БЛОК stmt */


if_stmt: /* оператор if */ 
      IF_KW '(' expr ')' stmt /* расставить приоритеты */
    | IF_KW '(' expr ')' stmt ELSE_KW stmt
;


while_stmt: /* оператор while */
      WHILE_KW '(' expr ')' stmt
;


do_while_stmt: /* оператор do while */
      DO_KW stmt WHILE_KW '(' expr ')' ';'
;


return_stmt:
      RETURN_KW ';'
    | RETURN_KW expr ';'
;


for_stmt: /* оператор for */
      FOR_KW '(' for_init ';' for_expr ';' expr_list_empty ')' stmt
    | FOR_KW '(' for_in_decl IN_KW expr ')' stmt
;


for_in_decl: /* объявление в for-in */ 
      ID
    | type ID
    | VAR_KW ID
    | FINAL_KW ID
    | FINAL_KW type ID
;


for_expr: /* условие в for */
      /* empty */
    | expr
;


for_init: /* блок инициализации for*/
      /* empty */
    | var_decl
    | expr
;


var_decl: /* полное объявление переменных, потом придумать всему блоку норм названия */
      type var_declarator_list
    | VAR_KW var_declarator_list
    | CONST_KW var_declarator_list
    | CONST_KW type var_declarator_list
    | FINAL_KW var_declarator_list
    | FINAL_KW type var_declarator_list
;


var_declarator: /* объявление переменной */
      ID
    | ID '=' expr
;


var_declarator_list: /* объявление нескольких переменных */
      var_declarator
    | var_declarator_list ',' var_declarator
;


/* БЛОК ФУНКЦИЙ */


func_decl:
      type ID '(' param_list_em ')' stmt_block
    | VOID_TYPE ID '(' param_list_em ')' stmt_block
;


param_list:
      type ID
    | param_list ',' type ID
;


param_list_em:
      /* empty */
    | param_list
;


getter_method_decl:
      type GET_KW ID stmt_block
;


setter_method_decl:
      SET_KW ID '(' type ID ')' stmt_block
    | VOID_TYPE SET_KW ID '(' type ID ')' stmt_block
;


static_method_decl:
      STATIC_KW func_decl
    | STATIC_KW getter_method_decl
    | STATIC_KW setter_method_decl
;


abstract_method_decl:
      type ID '(' param_list_em ')' ';'
    | VOID_TYPE ID '(' param_list_em ')' ';'
    | type GET_KW ID ';'
    | SET_KW ID '(' type ID ')' ';'
    | VOID_TYPE SET_KW ID '(' type ID ')' ';'
;


/* БЛОК КЛАССОВ */


class_decl:
      class_modifiers_em CLASS_KW ID extend_em '{' class_member_list_em '}'
;


class_modifiers_em:
      /* empty */
    | ABSTRACT_KW
    | FINAL_KW
    | ABSTRACT_KW FINAL_KW
;


extend_em:
      /* empty */
    | EXTENDS_KW ID
;


class_member:
      var_decl ';'
    | STATIC_KW var_decl ';'
    | func_decl
    | getter_method_decl
    | setter_method_decl
    | static_method_decl
    | abstract_method_decl
;


class_member_list:
      class_member
    | class_member_list class_member
;


class_member_list_em:
      /* empty */
    | class_member_list
;

%%

void yyerror(char const * s) {
       printf("%s\n", s);
}


void main( int argc, char** argv ) {
    ++argv, --argc;
    if ( argc > 0 )
        yyin = fopen( argv[0], "r" );
    else
        yyin = stdin;

    yypars();

    if (yyin != stdin)
        fclose(yyin);
}