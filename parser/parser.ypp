%{
    #include <stdio.h>
%}

/* Литералы */
%token INT_LIT
%token DOUBLE_LIT
%token ID
%token STRING_LIT
%token BOOL_LIT

/* Ключевые слова */
%token BREAK_KW CATCH_KW CLASS_KW CONST_KW CONTINUE_KW
%token DEFAULT_KW DO_KW ELSE_KW ENAM_KW EXTENDS_KW FINAL_KW
%token FINALLY_KW FOR_KW IF_KW IN_KW IS_KW ISN_KW NEW_KW RETHROW_KW
%token RETURN_KW SUPER_KW THIS_KW THROW_KW TRY_KW
%token VAR_KW WHILE_KW TRUE_KW FALSE_KW NULL_KW
%token ABSTRACT_KW AS_KW EXPORT_KW FACTORY_KW GET_KW
%token IMPORT_KW REQUIRED_KW SET_KW STATIC_KW WHEN_KW LIST_KW

/* Типы */
%token VOID_TYPE

%token EQ NEQ LEQ GEQ /* == != <= >= */
%token LOG_AND LOG_OR /* && || */
%token INC DEC INTDIV/* ++ -- ~/ */

%token ADD_ASSIGN SUB_ASSIGN MUL_ASSIGN /* += -= *= */
%token DIV_ASSIGN MOD_ASSIGN INTDIV_ASSIGN /* /= %= ~/= */


/* приоритеты */
%right '=' ADD_ASSIGN SUB_ASSIGN MUL_ASSIGN DIV_ASSIGN MOD_ASSIGN INTDIV_ASSIGN /* assignment */
%right '?' ':' /* тернарный оператор */
%left LOG_OR /* logical OR */
%left LOG_AND /* logical AND */
%nonassoc EQ NEQ /* equality */
%nonassoc AS_KW IS_KW ISN_KW LEQ GEQ '<' '>' /* relational */
%left '+' '-' /* additive */
%left '*' '/' '%' INTDIV /* multiplicative */
%nonassoc '!' /* префикс */
%nonassoc INC DEC '.' UMINUS '[' /* постфикс */
%nonassoc '(' /* скобки */


%start program

%union {
    int Int;
    double Dbl;
    char* Str;
}

%%


stmt:
      var_decl ';'
    | expr ';'
    | ';'
    | for_stmt
    | while_stmt
    | do_while_stmt
    | if_stmt
    | return_stmt
    | stmt_block
    | BREAK_KW ';'
    | CONTINUE_KW ';'
;


stmt_block:
      '{' stmt_list_em '}'
;


stmt_list:
      stmt
    | stmt_list stmt
;


stmt_list_em:
      /* empty */
    | stmt_list
;


expr: /* !!!РАССТАВИТЬ ПРИОРИТЕТЫ!!!, !!! */
      primary
    | expr INC /* x++ */
    | expr DEC /* x-- */
    | expr '.' ID /* x.y */
    | ID '(' expr_list_empty ')' /* x(...) */
    | expr '.' ID '(' expr_list_empty ')' /* x.y(...) */
    | expr '[' expr ']' /* x[i] */
    | INC expr /*++x*/
    | DEC expr /*--x*/
    | '-' expr %prec UMINUS /*-x*/
    | '!' expr /*!x*/
    | expr '*' expr /* x*y */
    | expr '/' expr /* x/y */
    | expr '%' expr /* x%y */
    | expr INTDIV expr /* x~/y */
    | expr '+' expr /* x+y */
    | expr '-' expr /* x-y */
    | expr '<' expr /* x<y */
    | expr '>' expr /* x>y */
    | expr LEQ expr /* x<=y */
    | expr GEQ expr /* x>=y */
    | expr IS_KW type /* x is y */
    | expr AS_KW type /* x as y */
    | expr ISN_KW type /* x is! */
    | expr EQ expr /* x==y */
    | expr NEQ expr /* x!=y */
    | expr LOG_AND expr /* x&&y */
    | expr LOG_OR expr /* x||y */
    | expr '?' expr ':' expr
    | expr '=' expr
    | expr ADD_ASSIGN expr
    | expr SUB_ASSIGN expr
    | expr MUL_ASSIGN expr
    | expr DIV_ASSIGN expr
    | expr MOD_ASSIGN expr
    | expr INTDIV_ASSIGN expr
;


primary: /*базовые литералы*/
      INT_LIT
    | DOUBLE_LIT
    | ID
    | STRING_LIT
    | BOOL_LIT
    | NULL_KW
    | SUPER_KW
    | THIS_KW
    | '(' expr ')'
    | '[' expr_list_empty ']'
;

type:
      ID
    | LIST_KW '<' type '>'
;


expr_list_empty:
      expr_list
    | /*empty*/
;


expr_list:
      expr
    | expr_list ',' expr
;


/* БЛОК stmt */


if_stmt: /* оператор if */ 
      IF_KW '(' expr ')' stmt /* расставить приоритеты */
    | IF_KW '(' expr ')' stmt ELSE_KW stmt
;


while_stmt: /* оператор while */
      WHILE_KW '(' expr ')' stmt
;


do_while_stmt: /* оператор do while */
      DO_KW stmt WHILE_KW '(' expr ')' ';'
;


return_stmt:
      RETURN_KW ';'
    | RETURN_KW expr ';'
;


for_stmt: /* оператор for */
      FOR_KW '(' for_init ';' for_expr ';' expr_list_empty ')' stmt
    | FOR_KW '(' for_in_decl IN_KW expr ')' stmt
;


for_in_decl: /* объявление в for-in */ 
      ID
    | type ID
    | VAR_KW ID
    | FINAL_KW ID
    | FINAL_KW type ID
;


for_expr: /* условие в for */
      /* empty */
    | expr
;


for_init: /* блок инициализации for*/
      /* empty */
    | var_decl
    | expr
;


var_decl: /* полное объявление переменных, потом придумать всему блоку норм названия */
      type var_declarator_list
    | VAR_KW var_declarator_list
    | CONST_KW var_declarator_list
    | CONST_KW type var_declarator_list
    | FINAL_KW var_declarator_list
    | FINAL_KW type var_declarator_list
;


var_declarator: /* объявление переменной */
      ID
    | ID '=' expr
;


var_declarator_list: /* объявление нескольких переменных */
      var_declarator
    | var_declarator_list ',' var_declarator
;


/* БЛОК ФУНКЦИЙ */


func_decl:
      type ID '(' param_list_em ')' stmt_block
    | VOID_TYPE ID '(' param_list_em ')' stmt_block
;


param_list:
      type ID
    | param_list ',' type ID
;


param_list_em:
      /* empty */
    | param_list
;


/* БЛОК КЛАССОВ */




%%